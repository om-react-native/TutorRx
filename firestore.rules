rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User documents
    match /users/{userId} {
      // Users can read their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users can update their own data, but NOT subscription-related or admin fields
      allow update: if request.auth != null 
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasAny(['subscriptionStatus', 'stripeCustomerId', 'stripeSubscriptionId', 'subscriptionUpdatedAt', 'isAdmin']);
      
      // Allow creation on signup
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Chats subcollection
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Messages subcollection
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
    
    
    // Study plans
    match /studyPlans/{planId} {
      // Allow read if the plan belongs to the user
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Allow create if the new document has the user's ID
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Allow update/delete if the plan belongs to the user
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Questions
    match /questions/{questionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Scenarios
    match /scenarios/{scenarioId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Flashcards - Everyone can read active flashcards, only admins can write
    match /flashcards/{flashcardId} {
      // All authenticated users can read active flashcards
      allow read: if request.auth != null;
      
      // Only admins can create, update, or delete flashcards
      allow create, update, delete: if request.auth != null 
                                     && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Q&A Questions - Community questions and answers
    match /qaQuestions/{questionId} {
      // All authenticated users can read Q&A questions
      allow read: if request.auth != null;
      
      // All authenticated users can create Q&A questions
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid;
      
      // Users can update their own questions OR system can update answer/category fields
      allow update: if request.auth != null 
                    && (request.resource.data.userId == request.auth.uid
                        || !request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasAny(['userId', 'userName', 'questionText', 'createdAt']));
      
      // Only question owner can delete
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
      
      // LikedBy subcollection - track who liked each question
      match /likedBy/{userId} {
        // Users can read all likes
        allow read: if request.auth != null;
        
        // Users can only create/delete their own likes
        allow create, delete: if request.auth != null 
                              && request.auth.uid == userId;
      }
    }
  }
}

